{
  "name": "@nestlyjs/server",
  "version": "0.1.0",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "tsconfig.devServer.json"
  ],
  "bin": {
    "nestly": "dist/bin/nestly.js"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc && chmod +x ./dist/bin/nestly.js",
    "test": "vitest run --coverage",
    "prepublishOnly": "yarn build"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@babel/core": "^8.1.0",
    "chokidar": "6.0.0",
    "esbuild": "^0.28.0",
    "react-refresh": "^0.19.0",
    "ts-node": "10.9.2",
    "typescript": "7.0.2"
  },
  "description": "File-based full-stack React framework runtime and CLI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/The-Code-Monkey/NestlyJS.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/The-Code-Monkey/NestlyJS#readme",
  "bugs": {
    "url": "https://github.com/The-Code-Monkey/NestlyJS/issues"
  },
  "keywords": [
    "react",
    "ssr",
    "framework",
    "file-based-routing",
    "full-stack"
  ]
}
